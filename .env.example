# PostgreSQL
DATABASE_URL="postgresql://accstacks:replace-with-a-strong-password@localhost:5432/accstacks?schema=public"
POSTGRES_DB="accstacks"
POSTGRES_USER="accstacks"
POSTGRES_PASSWORD="replace-with-a-strong-password"

# Generate secrets with Node: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Stable key for Next.js Server Actions in production/multi-instance deployments
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-an-independent-random-key"

# Production Compose uses the private Docker hostname "db"
PRODUCTION_DATABASE_URL="postgresql://accstacks:replace-with-a-strong-password@db:5432/accstacks?schema=public"
APP_PORT="3000"

# Owner provisioning (use a unique strong password; never commit real values)
OWNER_NAME="AccStacks Owner"
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="replace-with-a-unique-password"

# Optional explicit development seed (disabled without running pnpm db:seed)
SEED_OWNER_NAME="Demo Reseller"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-a-unique-password"

# Test-only isolated database
TEST_DATABASE_URL="postgresql://accstacks:replace-with-a-strong-password@localhost:5432/accstacks_test?schema=public"
